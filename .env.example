# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend
REDIS_URL=redis://localhost:6379/0
USE_CELERY=false
MEDIA_STORAGE_DIR=/tmp/mediasphere_storage
CORS_ORIGINS=*

# Optional: S3 (signed bucket URLs) — leave blank for ephemeral disk storage
# S3_BUCKET=
# S3_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
