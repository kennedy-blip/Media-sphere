# Optional: only set API_PROXY_TARGET when proxying /api/v1/* to a dedicated FastAPI server.
# Leave unset on Vercel to use MediaSphere's built-in real Node.js + FFmpeg extraction engine!
# API_PROXY_TARGET=http://127.0.0.1:8000

# Optional: only set NEXT_PUBLIC_API_URL when browser clients should call a separate public API domain directly
# NEXT_PUBLIC_API_URL=https://api.example.com

# Backend (FastAPI + Celery worker)
REDIS_URL=redis://localhost:6379/0
USE_CELERY=false
MEDIA_STORAGE_DIR=/tmp/mediasphere_storage
CORS_ORIGINS=*

# Optional: S3 (signed bucket URLs) — leave blank for ephemeral disk storage
# S3_BUCKET=
# S3_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
